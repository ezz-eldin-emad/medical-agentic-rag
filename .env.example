# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_TRANSPORT=polling
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=

# LLM API (the application intentionally uses a hosted LLM)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Phoenix tracing for agent routing spans.
PHOENIX_ENABLED=false
PHOENIX_PROJECT_NAME=medical-agentic-rag
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_API_KEY=

# Qdrant Cloud (used by the Vercel deployment)
QDRANT_URL=https://<cluster>.qdrant.io
QDRANT_API_KEY=
QDRANT_STORAGE_COLLECTION=medical_kb
QDRANT_CLINIC_COLLECTION=clinic_kb
QDRANT_STATE_COLLECTION=medical_app_state

# Embeddings: local BGE-M3 is the default.
# EMBEDDER_BACKEND=local
# Optional hosted mode: use Hugging Face Inference for query-time embeddings.
# EMBEDDER_BACKEND=huggingface
# HF_TOKEN=your_huggingface_read_token
# Use a model exposed by an HF Inference Provider (BGE-M3 is not hosted there).
# HF_EMBED_MODEL=intfloat/multilingual-e5-large
# Legacy Modal mode (optional):
# EMBEDDER_BACKEND=modal
# MODAL_EMBED_URL=https://your-endpoint.modal.run
MODAL_EMBED_TOKEN=

# Deployment persistence. Vercel uses Qdrant for state.
STATE_BACKEND=qdrant

# HuggingFace Token (for hosted inference or local model downloads)
HF_TOKEN=
