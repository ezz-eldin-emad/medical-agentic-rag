# Gemini API Key (Google AI Studio — comma-separated for key rotation)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM chat/completions (must use gemini/ prefix — bare gemini-* routes to Vertex AI)
LLM_DEFAULT_MODEL=gemini/gemini-3.5-flash
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=90

# Qdrant Database Configuration
# For local development (Docker): http://localhost:6333
# For production (Qdrant Cloud): your cluster URL
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# ── Embeddings (RAG)────────────────────────────────────
# local  = FlagEmbedding on laptop/Colab (indexing; dense + sparse)
# hf_api = HuggingFace Inference API (query-time on free hosting; dense only)
EMBEDDER_BACKEND=local
BGE_MODEL_ID=BAAI/bge-m3

# HuggingFace Token (model download + Inference API)
HF_TOKEN=your_huggingface_token_here

# Bot Credentials (to be added when integrating Telegram/WhatsApp)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
